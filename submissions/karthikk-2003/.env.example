# Documentation only: this application does not load .env files.
# Configure values in the hosting platform's secret/environment settings.
DEPLOYMENT_MODE=demo
PORT=8000
DEMO_PUBLIC_ORIGIN=https://your-demo-host.example
# Replace privately with a randomly generated URL-safe token of 32-128 characters.
DEMO_ACCESS_TOKEN=REPLACE_PRIVATELY
# GROQ_API_KEY is optional for separately authorized local collection inspection.
# No provider key is needed or read by the hosted demo.
